# DeJournal configuration. Copy to `.env` and fill in what you need.
# Everything here is optional — the app works fully without any of it.

# --- Optional AI (server-side only; never exposed to the browser) ---
# Used by `npm run ai-server` (server/ai-proxy.mjs).
ANTHROPIC_API_KEY=
# Model id (default: claude-opus-5-5)
AI_MODEL=
# Reasoning effort: low | medium | high (default: medium)
AI_EFFORT=
# Port for the AI proxy; the Vite dev server proxies /api to it (default: 8787)
AI_PORT=8787

# --- Optional Google Calendar (read-only import) ---
# OAuth 2.0 Web client ID from Google Cloud Console. Client IDs are public
# identifiers (not secrets), so this one is read by the browser build.
VITE_GOOGLE_CLIENT_ID=
